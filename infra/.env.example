# Copiar este archivo a .env y ajustar los valores antes de levantar los servicios.
# Los valores de ejemplo NO son aptos para produccion.

# PostgreSQL
POSTGRES_USER=scrum_user
POSTGRES_PASSWORD=changeme-in-prod
POSTGRES_DB=scrum_db

# MongoDB
MONGO_INITDB_ROOT_USERNAME=scrum_user
MONGO_INITDB_ROOT_PASSWORD=changeme-in-prod

# Redis
REDIS_PASSWORD=changeme-in-prod
